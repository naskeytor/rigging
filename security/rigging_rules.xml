<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- COMPONENTS -->
        <record id="rule_user_own_components" model="ir.rule">
            <field name="name">User: own components only</field>
            <field name="model_id" ref="model_rigging_component"/>
            <field name="domain_force">[('owner_id','=', user.partner_id.id)]</field>
            <field name="groups" eval="[(6, ref('rigging.group_rigging_user'))]"/>
        </record>

        <!-- RIGS -->
        <record id="rule_user_own_rigs" model="ir.rule">
            <field name="name">User: own rigs only</field>
            <field name="model_id" ref="model_rigging_rig"/>
            <field name="domain_force">[('owner_id','=', user.partner_id.id)]</field>
            <field name="groups" eval="[(6, ref('rigging.group_rigging_user'))]"/>
        </record>

        <!-- RIGGING -->
        <record id="rule_user_own_rigging" model="ir.rule">
            <field name="name">User: own rigging only</field>
            <field name="model_id" ref="model_rigging_rigging"/>
            <field name="domain_force">[('owner_id','=', user.partner_id.id)]</field>
            <field name="groups" eval="[(6, ref('rigging.group_rigging_user'))]"/>
        </record>

        <!-- PORTAL: cada cliente solo ve sus propios datos -->
        <record id="rule_portal_own_components" model="ir.rule">
            <field name="name">Portal: own components only</field>
            <field name="model_id" ref="model_rigging_component"/>
            <field name="domain_force">[('owner_id','=', user.partner_id.id)]</field>
            <field name="groups" eval="[(6, 0, [ref('base.group_portal')])]"/>
        </record>

        <record id="rule_portal_own_rigs" model="ir.rule">
            <field name="name">Portal: own rigs only</field>
            <field name="model_id" ref="model_rigging_rig"/>
            <field name="domain_force">[('owner_id','=', user.partner_id.id)]</field>
            <field name="groups" eval="[(6, 0, [ref('base.group_portal')])]"/>
        </record>

        <record id="rule_portal_own_rigging" model="ir.rule">
            <field name="name">Portal: own rigging only</field>
            <field name="model_id" ref="model_rigging_rigging"/>
            <field name="domain_force">[('owner_id','=', user.partner_id.id)]</field>
            <field name="groups" eval="[(6, 0, [ref('base.group_portal')])]"/>
        </record>

    </data>
</odoo>