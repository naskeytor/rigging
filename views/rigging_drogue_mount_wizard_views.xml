<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_rigging_drogue_mount_wizard_form" model="ir.ui.view">
        <field name="name">rigging.drogue.mount.wizard.form</field>
        <field name="model">rigging.drogue.mount.wizard</field>
        <field name="arch" type="xml">
            <form string="Drogue">
                <sheet>
                    <group>
                        <field name="action_type"/>
                        <field name="drogue_id"/>
                    </group>

                    <group>
                        <field name="container_id"
                               readonly="action_type == 'unmount'"/>
                    </group>

                    <footer>
                        <button name="action_apply"
                                type="object"
                                string="Apply"
                                class="btn-primary"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>