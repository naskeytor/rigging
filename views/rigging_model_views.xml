<odoo>
    <data>

        <!-- ACTION -->
        <record id="rigging_model_action" model="ir.actions.act_window">
            <field name="name">Models</field>
            <field name="res_model">rigging.model</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- LIST VIEW -->
        <record id="rigging_model_list" model="ir.ui.view">
            <field name="name">rigging.model.list</field>
            <field name="model">rigging.model</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="rigging_model_form" model="ir.ui.view">
            <field name="name">rigging.model.form</field>
            <field name="model">rigging.model</field>
            <field name="arch" type="xml">
                <form string="Model">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- MENU ITEM (DENTRO DE SETTINGS) -->
        <menuitem name="Model"
                  id="rigging.menu_model"
                  parent="rigging.menu_settings"
                  action="rigging_model_action"/>

    </data>
</odoo>