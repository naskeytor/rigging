<odoo>
    <data>

        <record id="view_rigging_task_wizard_form" model="ir.ui.view">
            <field name="name">rigging.task.wizard.form</field>
            <field name="model">rigging.task.wizard</field>
            <field name="arch" type="xml">
                <form string="New Task">
                    <sheet>
                        <group col="1">
                            <field name="customer_id"/>
                            <field name="rig_id" options="{'no_create': True}"/>
                            <field name="component_type"/>
                            <field name="issue" placeholder="Describe the problem..."/>
                        </group>
                    </sheet>

                    <footer>
                        <button string="Create" type="object" name="action_submit" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_rigging_task_wizard" model="ir.actions.act_window">
            <field name="name">New Task</field>
            <field name="res_model">rigging.task.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>