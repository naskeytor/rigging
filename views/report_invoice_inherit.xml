<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="report_invoice_document_inherit"
                  inherit_id="account.report_invoice_document">

            <xpath expr="//div[@name='invoice_date']//div[@t-field='o.invoice_date']" position="attributes">
                <attribute name="t-options">{"widget": "date", "format": "dd/MM/yyyy"}</attribute>
            </xpath>

            <xpath expr="//div[@name='due_date']//div[@t-field='o.invoice_date_due']" position="attributes">
                <attribute name="t-options">{"widget": "date", "format": "dd/MM/yyyy"}</attribute>
            </xpath>

            <xpath expr="//div[@name='taxable_supply_date']//div[@t-field='o.taxable_supply_date']" position="attributes">
                <attribute name="t-options">{"widget": "date", "format": "dd/MM/yyyy"}</attribute>
            </xpath>

            <xpath expr="//div[@name='delivery_date']//div[@t-field='o.delivery_date']" position="attributes">
                <attribute name="t-options">{"widget": "date", "format": "dd/MM/yyyy"}</attribute>
            </xpath>

            <xpath expr="//p[@name='taxes_legal_notes']" position="after">
                <p class="mt-2" style="font-size:9px; text-align:justify;">
                    Operación exenta de IVA según el art. 6.1.j del Real Decreto 1619/2012,
                    de 30 de noviembre, al tener la consideración como exportación según
                    artículo 21 de la Ley 37/1992, de 28 de noviembre.
                </p>
            </xpath>

        </template>

    </data>
</odoo>
