<odoo>

    <record id="view_aad_jumps_wizard_form" model="ir.ui.view">
        <field name="name">rigging.aad.jumps.wizard.form</field>
        <field name="model">rigging.aad.jumps.wizard</field>
        <field name="arch" type="xml">
            <form string="AAD Jumps">
                <sheet>
                    <group>
                        <field name="action_type" readonly="1"/>
                        <field name="component_id" readonly="1"/>
                        <field name="rig_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="current_jumps"/>
                        <field name="aad_jumps"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm"
                            type="object"
                            name="action_confirm"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>