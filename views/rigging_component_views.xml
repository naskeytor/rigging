<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- LIST VIEW -->
        <record id="rigging_component_list" model="ir.ui.view">
            <field name="name">rigging.component.list</field>
            <field name="model">rigging.component</field>
            <field name="arch" type="xml">
                <list string="Components">
                    <field name="name"/>
                    <field name="component_type"/>
                    <field name="usage_type"/>
                    <field name="manufacturer_id"/>
                    <field name="model_id"/>
                    <field name="size_id"/>
                    <field name="owner_id"/>
                    <field name="dom"/>
                    <field name="jumps_on_mount"/>
                    <field name="last_jumps_update"/>
                    <field name="total_jumps"/>
                    <field name="rig_id"/>
                    <field name="is_mounted"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="rigging_component_form" model="ir.ui.view">
            <field name="name">rigging.component.form</field>
            <field name="model">rigging.component</field>
            <field name="arch" type="xml">
                <form string="Component">
                    <sheet>

                        <group>
                            <field name="name"/>
                            <field name="component_type"/>
                            <field name="usage_type"/>
                        </group>

                        <group>
                            <field name="manufacturer_id"/>
                            <field name="model_id"/>
                            <field name="size_id"/>
                        </group>

                        <group>
                            <field name="owner_id"/>
                            <field name="dom"/>
                            <field name="jumps_on_mount"/>
                            <field name="last_jumps_update"/>
                            <field name="total_jumps"/>
                            <field name="last_repack"
                                   modifiers="{'invisible': [['component_type', '!=', 'reserve']]}"/>
                            <field name="has_reline" invisible="1"/>
                            <field name="jumps_on_lineset" invisible="not has_reline"/>
                            <field name="has_drogue_replace" invisible="1"/>
                            <field name="jumps_on_drogue"
                                   invisible="component_type != 'container' or usage_type != 'tandem'"/>
                            <field name="has_killline_replace" invisible="1"/>
                            <field name="jumps_on_killline"
                                   invisible="component_type != 'container' or usage_type != 'tandem'"/>
                            <field name="has_100_jumps_inspection" invisible="1"/>
                            <field name="jumps_on_100_inspection"
                                   invisible="component_type != 'container' or usage_type != 'tandem'"/>
                        </group>

                        <group>
                            <field name="rig_id"
                                   context="{
                       'component_type': component_type,
                       'current_component_id': id,
                       'usage_type': usage_type
                     }"/>
                            <field name="is_mounted"/>
                        </group>

                        <group string="Component Actions">
                            <button name="action_open_mount_wizard"
                                    type="object"
                                    string="Mount"
                                    class="btn-primary"
                                    invisible="is_mounted"/>
                            <button name="action_open_unmount_wizard"
                                    type="object"
                                    string="Unmount"
                                    class="btn-secondary"
                                    invisible="not is_mounted"/>
                            <button name="action_refresh"
                                    type="object"
                                    string="Refresh"
                                    class="btn-secondary"/>
                        </group>

                        <group string="Drogues"
                               invisible="component_type != 'container' or usage_type != 'tandem'">
                            <field name="drogue_ids"
                                   context="{
                       'default_container_id': id,
                       'tree_view_ref': 'rigging.view_rigging_drogue_list_embedded',
                       'form_view_ref': 'rigging.view_rigging_drogue_form'
                     }"/>
                        </group>

                        <group string="Lineset"
                               invisible="component_type != 'canopy'">
                            <field name="lineset_ids"
                                   context="{
                       'default_canopy_id': id,
                       'tree_view_ref': 'rigging.view_rigging_lineset_list_embedded',
                       'form_view_ref': 'rigging.view_rigging_lineset_form'
                     }"/>
                        </group>

                        <group string="Rigging History">
                            <field name="rigging_ids"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>


        <!-- SEARCH VIEW -->
        <record id="rigging_component_search" model="ir.ui.view">
            <field name="name">rigging.component.search</field>
            <field name="model">rigging.component</field>
            <field name="arch" type="xml">
                <search string="Components">

                    <field name="name"/>
                    <field name="owner_id"/>
                    <field name="manufacturer_id"/>
                    <field name="model_id"/>
                    <field name="size_id"/>
                    <field name="component_type"/>
                    <field name="usage_type"/>
                    <field name="rig_id"/>

                    <separator/>

                    <filter string="Sport"
                            name="sport"
                            domain="[('usage_type','=','sport')]"/>
                    <filter string="Tandem"
                            name="tandem"
                            domain="[('usage_type','=','tandem')]"/>
                    <filter string="Pilot"
                            name="pilot"
                            domain="[('usage_type','=','pilot')]"/>
                    <filter string="Canopies"
                            name="canopies"
                            domain="[('component_type','=','canopy')]"/>
                    <filter string="Containers"
                            name="containers"
                            domain="[('component_type','=','container')]"/>
                    <filter string="Reserves"
                            name="reserves"
                            domain="[('component_type','=','reserve')]"/>
                    <filter string="AADs"
                            name="aads"
                            domain="[('component_type','=','aad')]"/>


                    <separator string="Group By"/>

                    <filter string="Group by Type" name="gb_type" context="{'group_by':'component_type'}"/>
                    <filter string="Group by Discipline" name="gb_usage" context="{'group_by':'usage_type'}"/>
                    <filter string="Group by Size" name="gb_size" context="{'group_by':'size_id'}"/>
                    <filter string="Group by Owner" name="gb_owner" context="{'group_by':'owner_id'}"/>
                    <filter string="Group by Rig" name="gb_rig" context="{'group_by':'rig_id'}"/>
                    <filter string="Group by Mounted" name="gb_is_mounted" context="{'group_by':'is_mounted'}"/>

                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="rigging_component_action" model="ir.actions.act_window">
            <field name="name">Components</field>
            <field name="res_model">rigging.component</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="rigging_component_search"/>
        </record>

        <!-- MENU -->

    </data>
</odoo>