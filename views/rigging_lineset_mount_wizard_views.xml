<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_rigging_lineset_mount_wizard_form" model="ir.ui.view">
        <field name="name">rigging.lineset.mount.wizard.form</field>
        <field name="model">rigging.lineset.mount.wizard</field>
        <field name="arch" type="xml">
            <form string="Lineset">
                <sheet>
                    <group>
                        <field name="action_type"/>
                        <field name="lineset_id"/>
                    </group>

                    <group>
                        <field name="canopy_id" readonly="action_type == 'unmount'"/>
                    </group>

                    <group string="Jumps">
                        <field name="canopy_last_jumps_update"/>
                        <field name="lineset_jumps_on_mount"/>
                        <field name="lineset_total_jumps"/>
                    </group>

                    <footer>
                        <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>