<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="rigging_lineset_action" model="ir.actions.act_window">
        <field name="name">Linesets</field>
        <field name="res_model">rigging.lineset</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rigging_lineset_list" model="ir.ui.view">
        <field name="name">rigging.lineset.list</field>
        <field name="model">rigging.lineset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="manufacturer_id"/>
                <field name="model_id"/>
                <field name="canopy_id" string="Mounted on"/>
                <field name="mounted_on" string="Mounted at"/>
                <field name="total_jumps"/>
            </list>
        </field>
    </record>

    <record id="view_rigging_lineset_form" model="ir.ui.view">
        <field name="name">rigging.lineset.form</field>
        <field name="model">rigging.lineset</field>
        <field name="arch" type="xml">
            <form string="Lineset">
                <header>
                    <button name="action_mount"
                            type="object"
                            string="Mount"
                            class="btn-primary"
                            invisible="is_mounted"/>

                    <button name="action_unmount"
                            type="object"
                            string="Unmount"
                            class="btn-secondary"
                            invisible="not is_mounted"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="manufacturer_id"/>
                            <field name="model_id"/>
                            <field name="dom"/>
                        </group>

                        <group>
                            <field name="canopy_id"/>
                            <field name="mounted_on"/>
                            <field name="is_mounted"/>
                        </group>

                        <group string="Jumps">
                            <field name="jumps_on_mount"/>
                            <field name="last_jumps_update"/>
                            <field name="total_jumps"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>