<odoo>
    <data>

        <!-- Acción Rigs -->
        <record id="rigging_rig_action" model="ir.actions.act_window">
            <field name="name">Rigs</field>
            <field name="res_model">rigging.rig</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- LIST VIEW -->
        <record id="rigging_rig_list" model="ir.ui.view">
            <field name="name">rigging.rig.list</field>
            <field name="model">rigging.rig</field>
            <field name="arch" type="xml">
                <list string="Rigs">
                    <field name="number"/>
                    <field name="owner_id"/>
                    <field name="canopy_id"/>
                    <field name="container_id"/>
                    <field name="reserve_id"/>
                    <field name="aad_id"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW (solo se edita número y owner) -->
        <record id="rigging_rig_form" model="ir.ui.view">
            <field name="name">rigging.rig.form</field>
            <field name="model">rigging.rig</field>
            <field name="arch" type="xml">
                <form string="Rig">
                    <sheet>
                        <!-- Solo editable: número y owner -->
                        <group>
                            <field name="number"/>
                            <field name="owner_id"/>
                        </group>

                        <!-- Componentes montados: SOLO LECTURA -->
                        <group string="Mounted Components">
                            <field name="canopy_id"
                                   readonly="1"
                                   options="{'no_create_edit': True}"/>
                            <field name="container_id"
                                   readonly="1"
                                   options="{'no_create_edit': True}"/>
                            <field name="reserve_id"
                                   readonly="1"
                                   options="{'no_create_edit': True}"/>
                            <field name="aad_id"
                                   readonly="1"
                                   options="{'no_create_edit': True}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Menú Rigs -->
        <menuitem name="Rigs"
                  id="rigging.menu_rigs"
                  parent="rigging.menu_root"
                  action="rigging_rig_action"/>

    </data>
</odoo>