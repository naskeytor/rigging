<odoo>

    <record id="rigging_rigging_list" model="ir.ui.view">
        <field name="name">rigging.rigging.list</field>
        <field name="model">rigging.rigging</field>
        <field name="arch" type="xml">
            <list string="Rigging Jobs">
                <field name="owner_id"/>
                <field name="date"/>
                <field name="component_id"/>
                <field name="rigging_type"/>
                <!-- solo esta columna se colorea -->
                <field name="price_color" widget="html" string="Price"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="rigging_rigging_form" model="ir.ui.view">
        <field name="name">rigging.rigging.form</field>
        <field name="model">rigging.rigging</field>
        <field name="arch" type="xml">
            <form string="Rigging Job">
                <sheet>
                    <group>
                        <field name="owner_id"/>
                        <field name="component_id"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="rigging_type"/>
                        <field name="jumps" invisible="not component_is_mounted"/>
                    </group>
                    <field name="component_type" invisible="1"/>
                    <field name="component_usage_type" invisible="1"/>
                    <field name="component_is_mounted" invisible="1"/>
                    <group string="Work Performed">
                        <field name="reline" invisible="component_type != 'canopy'"/>
                        <field name="drogue_replace"
                               invisible="component_type != 'container' or component_usage_type != 'tandem'"/>
                        <field name="killline_replace"
                               invisible="component_type != 'container' or component_usage_type != 'tandem'"/>
                        <field name="inspection_100_jumps"
                               invisible="component_type != 'container' or component_usage_type != 'tandem'"/>
                    </group>
                    <group>
                        <field name="price"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW: Rigging Jobs -->
    <record id="rigging_rigging_search" model="ir.ui.view">
        <field name="name">rigging.rigging.search</field>
        <field name="model">rigging.rigging</field>
        <field name="arch" type="xml">
            <search string="Rigging Jobs">

                <!-- Quick search fields -->
                <field name="name"/>
                <field name="date"/>
                <field name="owner_id"/>
                <field name="component_id"/>
                <field name="rigging_type"/>
                <field name="state"/>

                <separator/>

                <!-- Common filters -->
                <filter string="Pending" name="pending" domain="[('state','=','pending')]"/>
                <filter string="Paid" name="paid" domain="[('state','=','paid')]"/>
                <filter string="SKDM" name="skdm" domain="[('owner_id','=','SKDM')]"/>

                <separator/>

                <!-- Date helpers (you can tweak later) -->


                <separator string="Group By"/>

                <!-- Group by (safe: as filters, no <group>) -->
                <filter string="Group by Type" name="gb_type" context="{'group_by':'rigging_type'}"/>
                <filter string="Group by State" name="gb_state" context="{'group_by':'state'}"/>
                <filter string="Group by Date" name="gb_date" context="{'group_by':'date'}"/>
                <filter string="Group by Owner" name="gb_owner" context="{'group_by':'owner_id'}"/>
                <filter string="Group by Component" name="gb_component" context="{'group_by':'component_id'}"/>

            </search>
        </field>
    </record>

    <record id="rigging_rigging_action" model="ir.actions.act_window">
        <field name="name">Rigging Jobs</field>
        <field name="res_model">rigging.rigging</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="rigging_rigging_search"/>
    </record>

</odoo>