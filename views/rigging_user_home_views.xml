<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- singleton -->
        <record id="rigging_user_home_singleton" model="rigging.user.home">
            <field name="name">My Equipment</field>
        </record>

        <!-- action -->
        <record id="action_rigging_user_home" model="ir.actions.act_window">
            <field name="name">My Equipment</field>
            <field name="res_model">rigging.user.home</field>
            <field name="view_mode">form</field>
            <field name="res_id" ref="rigging.rigging_user_home_singleton"/>
            <field name="domain">[]</field>
            <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        </record>

        <!-- form view -->
        <record id="view_rigging_user_home_form" model="ir.ui.view">
            <field name="name">rigging.user.home.form</field>
            <field name="model">rigging.user.home</field>
            <field name="arch" type="xml">
                <form string="My Equipment">
                    <sheet>
                        <div class="o_form_label">My Equipment</div>

                        <group>
                            <button name="action_open_my_rigs"
                                    type="object"
                                    string="Open My Rigs"
                                    class="btn-primary btn-lg"/>
                        </group>

                        <div class="mt16">
                            Here we will show your rigs and components.
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>