<odoo>
    <data>

        <!-- Acción -->
        <record id="rigging_manufacturer_action" model="ir.actions.act_window">
            <field name="name">Manufacturers</field>
            <field name="res_model">rigging.manufacturer</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Lista -->
        <record id="rigging_manufacturer_list" model="ir.ui.view">
            <field name="name">rigging.manufacturer.list</field>
            <field name="model">rigging.manufacturer</field>
            <field name="arch" type="xml">
                <list string="Manufacturers">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Formulario -->
        <record id="rigging_manufacturer_form" model="ir.ui.view">
            <field name="name">rigging.manufacturer.form</field>
            <field name="model">rigging.manufacturer</field>
            <field name="arch" type="xml">
                <form string="Manufacturer">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Menú dentro de Settings -->
        <menuitem name="Manufacturers"
                  id="rigging.menu_manufacturer"
                  parent="rigging.menu_settings"
                  action="rigging_manufacturer_action"/>

    </data>
</odoo>